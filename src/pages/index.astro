---
import Base from '../layouts/Base.astro';

const cities = ['Paris', 'London', 'SF', 'Miami', 'Zurich', 'Geneva'];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Club Y',
  url: 'https://club-y.co/',
  logo: 'https://club-y.co/favicon/android-chrome-512x512.png',
  description: 'A global community of founders, investors & those in between.',
  sameAs: ['https://substack.com/@wearecluby'],
};
---

<Base schema={schema}>
  <div class="centre">
    <h1>
      <svg class="wordmark" viewBox="0 0 242 58" role="img" aria-label="Club Y">
        <path
          fill="currentColor"
          d="M26.3736 58C11.2607 58 0 45.7684 0 30.3058V30.1519C0 14.8432 11.0384 2.3039 26.7441 2.3039C36.3008 2.3039 42.0793 5.76567 47.0429 10.6891L41.1903 17.6896C37.0416 13.6893 32.5966 10.9968 26.67 10.9968C16.7428 10.9968 9.55674 19.4589 9.55674 29.9981V30.1519C9.55674 40.6911 16.7428 49.3071 26.67 49.3071C33.0411 49.3071 37.1157 46.6146 41.5607 42.3066L47.4133 48.4609C42.0052 54.3074 36.0786 58 26.3736 58ZM56.4723 57.0769V0.919189H65.4364V57.0769H56.4723ZM90.6345 57.9231C81.8186 57.9231 76.7069 51.7688 76.7069 42.3066V16.4587H85.6709V39.5372C85.6709 45.8453 88.7084 49.461 94.0424 49.461C99.2282 49.461 102.858 45.6915 102.858 39.3833V16.4587H111.822V57.0769H102.858V50.7687C100.339 54.6152 96.7094 57.9231 90.6345 57.9231ZM145.317 57.9231C138.871 57.9231 134.797 54.5382 132.056 50.7687V57.0769H123.092V0.919189H132.056V23.2284C134.945 18.9973 139.02 15.6125 145.317 15.6125C154.577 15.6125 163.541 23.2284 163.541 36.6909V36.8447C163.541 50.3072 154.651 57.9231 145.317 57.9231ZM143.242 49.8456C149.391 49.8456 154.429 44.8453 154.429 36.8447V36.6909C154.429 28.8442 149.317 23.69 143.242 23.69C137.168 23.69 131.833 28.9211 131.833 36.6909V36.8447C131.833 44.6914 137.168 49.8456 143.242 49.8456Z"
        ></path>
        <path
          fill="var(--lilac)"
          d="M199.358 57.0769L211.231 35.8446L190.635 3.22704H201.377L215.898 27.0748L230.566 3.22704H241.012L220.417 35.6139L209.647 57.0769H199.358Z"
        ></path>
      </svg>
    </h1>

    <p class="statement">
      <span class="line">
        From NYC to <span class="cities" aria-hidden="true">
          {cities.map((city, i) => <span class:list={['city', { 'is-on': i === 0 }]}>{city}</span>)}
        </span>
        <span class="sr-only">{new Intl.ListFormat('en').format(cities)}.</span>
      </span>
      <span class="line">We are founders, investors &amp; those in between.</span>
    </p>
  </div>

  <script>
    // Roll through the cities: the old one leaves upwards, the next arrives from below, and the slot's width
    // follows the word so the line stays centred. Widths are set in em, so they hold when the type scales.
    const slot = document.querySelector<HTMLElement>('.cities')!;
    const cities = [...slot.children] as HTMLElement[];
    const fit = (city: HTMLElement) => {
      slot.style.width = `${city.getBoundingClientRect().width / parseFloat(getComputedStyle(slot).fontSize)}em`;
    };
    let on = 0;

    await document.fonts.ready;
    fit(cities[on]);

    setInterval(() => {
      if (document.hidden) return;
      cities.at(on - 1)!.classList.remove('is-off'); // the one that left last time drops back below, unseen
      cities[on].classList.replace('is-on', 'is-off');
      on = (on + 1) % cities.length;
      cities[on].classList.add('is-on');
      fit(cities[on]);
    }, 2600);
  </script>
</Base>

<style>
  .wordmark {
    display: block;
    width: auto;
    height: calc(var(--t-lg) * 1.8);
  }

  .line {
    display: block;
  }

  .line + .line {
    color: var(--muted);
  }

  /* One city shows at a time. The others wait out of flow, so the slot is exactly as wide as the word on show. */
  .cities {
    position: relative;
    display: inline-block;
    font-weight: 500;
    white-space: nowrap;
    transition: width 0.7s var(--ease);
  }

  .city {
    display: inline-block;
    transition:
      opacity 0.45s ease,
      translate 0.7s var(--ease),
      filter 0.45s ease;
  }

  .city:not(.is-on) {
    position: absolute;
    inset: 0 auto auto 0;
    opacity: 0;
    translate: 0 0.4em;
    filter: blur(0.15em);
  }

  .city.is-off {
    translate: 0 -0.4em;
  }

  @media (prefers-reduced-motion: reduce) {
    .cities {
      transition: none;
    }

    .city {
      translate: none !important;
      filter: none !important;
    }
  }
</style>
