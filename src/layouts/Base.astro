---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Structured data for search engines. */
  schema?: Record<string, unknown>;
}

const {
  title = 'Club Y',
  description = 'A global community of founders, investors & those in between. From NYC to the world.',
  noindex = false,
  schema,
} = Astro.props;

// The public path: "/" or "/privacy", never "/privacy.html" (static builds report the file name).
const path = Astro.url.pathname.replace(/(\/index)?(\.html)?$/, '') || '/';
const canonical = new URL(path, Astro.site);
const shareImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Club Y" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Club Y" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/club-y.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <Font cssVariable="--font-sans" preload />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <div class="glow" aria-hidden="true"></div>

    <a class="mark" href="/" aria-label="Club Y, home">
      <img src="/club-y.svg" alt="" width="40" height="40" />
    </a>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <a href="https://workshoplab.org" aria-label="A product of Workshop Lab">
        {
          /* "product of" in Saans Regular, outlined, with the WL mark on its baseline at cap height. One drawing,
             so the words and the mark cannot drift apart from browser to browser. 1000 units are 1em. */
